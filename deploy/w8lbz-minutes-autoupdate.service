[Unit]
Description=Install a newer W8LBZ minutes release that needs no steps by hand, after a backup (if turned on on the Updates page)

[Service]
Type=oneshot
User=minutes
Group=minutes
WorkingDirectory=/opt/w8lbz-minutes
Environment=W8LBZ_CONFIG=/etc/w8lbz-minutes/club.yaml
Environment=W8LBZ_DATA=/var/lib/w8lbz-minutes
Environment=W8LBZ_GOOGLE_KEY=/etc/w8lbz-minutes/google-service-account.json
# W8LBZ_BACKUP_PASSPHRASE for the backup first, and the SMTP settings to tell the admins
EnvironmentFile=-/etc/w8lbz-minutes/env
ExecStart=/opt/w8lbz-minutes/.venv/bin/w8lbz-minutes auto-update
TimeoutStartSec=30min
