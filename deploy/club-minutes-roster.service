[Unit]
Description=Rebuild the roster cache from the roster the app keeps

[Service]
Type=oneshot
User=minutes
Group=minutes
WorkingDirectory=/opt/club-minutes
Environment=CLUB_MINUTES_CONFIG=/etc/club-minutes/club.yaml
Environment=CLUB_MINUTES_DATA=/var/lib/club-minutes
ExecStart=/opt/club-minutes/.venv/bin/club-minutes roster
# Pick up roster changes in the running app
ExecStartPost=+/bin/systemctl try-restart club-minutes
